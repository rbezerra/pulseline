# Database Configuration
DATABASE_URL=postgresql://pulseline:pulseline_password@localhost:5432/pulseline_db

# BFF Server Configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Vendor-Agnostic AI Configuration (gemini | openai | ollama | mock)
AI_PROVIDER=mock

# Google Gemini (when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Local (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
